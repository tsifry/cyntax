html {
    scroll-padding-top: 90px;
}

@media (prefers-reduced-motion: no-preference) {
    html {
        scroll-behavior: smooth;
    }
}

a:focus-visible,
button:focus-visible {
    outline: 3px solid #38BDF8;
    outline-offset: 3px;
}

/* ---------- Seção de recursos (escura) ---------- */
.beneficios.recursos {
    padding: 70px 80px;
    color: var(--cor-fonte-clara, #C9D6F2);
}

.recursos-conteudo {
    max-width: 1280px;
    margin: 0 auto;
}

.recursos-cabecalho {
    margin-bottom: 36px;
    text-align: center;
}

.recursos-cabecalho h2 {
    margin: 0 0 10px;
    color: var(--cor-fonte-branca, #FFFFFF);
    font-size: 38px;
}

.recursos-cabecalho p {
    margin: 0;
    color: var(--cor-fonte-clara, #C9D6F2);
    font-size: 17px;
}

/* ---------- Grade de cards ---------- */
.recursos-grade {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.recurso-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid transparent;
    border-radius: 20px;
    background:
        linear-gradient(#071329, #071329) padding-box,
        linear-gradient(90deg, #526EF8, #38BDF8) border-box;
    box-shadow: 10px 8px 8px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s;
}

.recurso-card:hover {
    transform: translateY(-4px);
}

.recurso-card > ion-icon {
    margin-bottom: 14px;
    color: var(--cor-ciano, #38BDF8);
    font-size: 42px;
}

.recurso-card h3 {
    margin: 0 0 8px;
    color: var(--cor-fonte-branca, #FFFFFF);
    font-size: 21px;
}

.recurso-desc {
    margin: 0 0 14px;
    color: var(--cor-fonte-clara, #C9D6F2);
    font-size: 14px;
    line-height: 1.5;
}

.recurso-para {
    margin: auto 0 0;
    color: var(--cor-fonte-clara, #C9D6F2);
    font-size: 13px;
    line-height: 1.4;
}

.recurso-para span {
    display: block;
    margin-bottom: 4px;
    color: var(--cor-fonte-simulacao, #38BDF8);
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ---------- Como ativar (seção clara) ---------- */
.explicacao.ativar {
    display: block;
    margin-left: 0;
    padding: 70px 80px;
}

.ativar-conteudo {
    max-width: 1280px;
    margin: 0 auto;
}

.ativar-topo {
    max-width: 640px;
    margin: 0 auto 40px;
    text-align: center;
}

.ativar-rotulo {
    display: block;
    margin-bottom: 10px;
    color: #2B57D6;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

.ativar-topo h2 {
    margin: 0 0 12px;
}

.ativar-topo > p {
    margin: 0;
    color: var(--cor-fonte-secundaria, #4A5B7C);
    font-size: 17px;
    line-height: 1.55;
}

.ativar-etapas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.ativar-etapa {
    padding: 24px;
    border: 1px solid #DCE6FA;
    border-radius: 20px;
    background-color: var(--cor-fundo-claro-2, #F3F7FF);
}

.ativar-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-bottom: 12px;
    border-radius: 50%;
    background: linear-gradient(90deg, #526EF8, #38BDF8);
    color: #FFFFFF;
    font-size: 17px;
    font-weight: bold;
}

.ativar-etapa h3 {
    margin: 0 0 8px;
    color: var(--cor-fonte-escura, #0B1B3F);
    font-size: 18px;
}

.ativar-etapa p {
    margin: 0;
    color: var(--cor-fonte-secundaria, #4A5B7C);
    font-size: 14px;
    line-height: 1.5;
}

.ativar-aviso {
    margin: 24px 0 0;
    text-align: center;
    color: #2B57D6;
    font-size: 14px;
    font-weight: bold;
}

/* ---------- Atalhos de teclado ---------- */
.atalhos {
    max-width: 640px;
    margin: 40px auto 0;
    padding: 24px;
    border: 1px solid #DCE6FA;
    border-radius: 20px;
    background-color: var(--cor-fundo-claro-2, #F3F7FF);
}

.atalhos h3 {
    margin: 0 0 14px;
    color: var(--cor-fonte-escura, #0B1B3F);
    font-size: 18px;
}

.atalhos-lista {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.atalhos-lista li {
    color: var(--cor-fonte-secundaria, #4A5B7C);
    font-size: 14px;
    line-height: 1.5;
}

kbd {
    display: inline-block;
    min-width: 28px;
    padding: 2px 8px;
    border: 1px solid #B8C7E8;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: var(--cor-fonte-escura, #0B1B3F);
    font-family: inherit;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
}

/* ---------- Botão e painel de acessibilidade ----------
   Se já estiverem estilizados em outro CSS, apague esta seção. */
#btnAcess {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: 50%;
    background: linear-gradient(90deg, #526EF8, #38BDF8);
    color: #FFFFFF;
    font-size: 30px;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s;
}

#btnAcess:hover {
    transform: scale(1.08);
}

#painelAcess {
    position: fixed;
    right: 24px;
    bottom: 92px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 240px;
    padding: 18px;
    border: 1px solid #DCE6FA;
    border-radius: 16px;
    background-color: #FFFFFF;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
}

#painelAcess[hidden] {
    display: none;
}

#painelAcess h3 {
    margin: 0 0 6px;
    color: #0B1B3F;
    font-size: 17px;
}

#painelAcess button {
    padding: 10px 12px;
    border: 1px solid #B8C7E8;
    border-radius: 10px;
    background-color: #F3F7FF;
    color: #0B1B3F;
    font-family: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s;
}

#painelAcess button:hover {
    background-color: #DCE6FA;
}

#painelAcess #resetar {
    margin-top: 4px;
    border-color: #2B57D6;
    background-color: #2B57D6;
    color: #FFFFFF;
    font-weight: bold;
}

#painelAcess #resetar:hover {
    background-color: #1F44B0;
}

/* ---------- Responsivo ---------- */
@media (max-width: 1100px) {
    .beneficios.recursos,
    .explicacao.ativar {
        padding: 60px 40px;
    }

    .recursos-grade {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 700px) {
    .beneficios.recursos,
    .explicacao.ativar {
        padding: 40px 20px;
    }

    .recursos-grade,
    .ativar-etapas {
        grid-template-columns: 1fr;
    }

    .recursos-cabecalho h2 {
        font-size: 30px;
    }

    .recursos-cabecalho p,
    .ativar-topo > p {
        font-size: 16px;
    }

    #btnAcess {
        right: 16px;
        bottom: 16px;
    }

    #painelAcess {
        right: 16px;
        bottom: 80px;
        width: calc(100vw - 32px);
        max-width: 280px;
    }
}

/* ---------- Menos movimento ---------- */
@media (prefers-reduced-motion: reduce) {
    .recurso-card,
    #btnAcess,
    #painelAcess button {
        transition: none !important;
        animation: none !important;
    }
}
